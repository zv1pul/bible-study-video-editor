#!/bin/bash
# Starts the app. Everything it needs is inside this bundle; the work of
# choosing a version, falling back and updating is in launcher.py.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RES="$HERE/../Resources"
export BSVE_HOME="$HOME/Library/Application Support/BibleStudyVideoEditor"
mkdir -p "$BSVE_HOME"
exec "$RES/python/bin/python3" "$RES/launcher.py"
